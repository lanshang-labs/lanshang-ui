{
  "name": "@lanshang-labs/ui",
  "version": "0.2.10",
  "description": "Lanshang UI: compact interfaces built on Ant Design, Beautiful UI and Iconoir",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanshang-labs/lanshang-ui.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc && node scripts/bundle-markdown-math.mjs && node scripts/copy-styles.mjs",
    "test": "vitest run",
    "dev": "vite --host 127.0.0.1",
    "check:examples": "tsc --noEmit -p tsconfig.examples.json",
    "prepack": "npm run build",
    "build:docs": "npm run build && npm run check:examples && LANSHANG_REGISTRY_OUT=.registry-build/public LANSHANG_REGISTRY_BASE=https://lanshang-labs.github.io/lanshang-ui/ node scripts/build-registry.mjs && vite build --config vite.docs.config.ts && node scripts/docs-notices.mjs",
    "preview:docs": "vite preview --config vite.docs.config.ts --host 127.0.0.1",
    "build:registry": "npm run build && node scripts/build-registry.mjs",
    "test:registry": "node scripts/verify-registry.mjs",
    "test:registry:ci": "node scripts/registry-ci.mjs",
    "check:published-history": "node scripts/check-published-history.mjs",
    "archive:published": "node scripts/archive-published.mjs"
  },
  "peerDependencies": {
    "antd": "^5.22.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "iconoir-react": "7.12.1",
    "prismjs": "^1.30.0",
    "react-markdown": "10.1.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.1",
    "@testing-library/react": "16.3.2",
    "@types/prismjs": "^1.26.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "antd": "5.22.5",
    "dayjs": "^1.11.23",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "katex": "0.19.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "shadcn": "4.21.4",
    "typescript": "5.7.2",
    "vite": "6.4.4",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "homepage": "https://lanshang-labs.github.io/lanshang-ui/",
  "overrides": {
    "katex": "$katex"
  }
}
