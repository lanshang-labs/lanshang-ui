{
  "name": "@lanshang-labs/ui",
  "version": "0.2.0",
  "description": "Lanshang UI: compact interfaces built on Ant Design, Beautiful UI and Iconoir",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanshang-labs/lanshang-ui.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-styles.mjs",
    "test": "vitest run",
    "dev": "vite --host 127.0.0.1",
    "check:examples": "tsc --noEmit -p tsconfig.examples.json",
    "prepack": "npm run build",
    "build:docs": "npm run build && npm run check:examples && vite build --config vite.docs.config.ts && node scripts/docs-notices.mjs",
    "preview:docs": "vite preview --config vite.docs.config.ts --host 127.0.0.1"
  },
  "peerDependencies": {
    "antd": "^5.22.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "iconoir-react": "7.12.1"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "antd": "5.22.5",
    "jsdom": "26.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.7.2",
    "vite": "6.4.4",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "homepage": "https://lanshang-labs.github.io/lanshang-ui/"
}
